<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ products, worst margin first ============ -->
    <record id="view_margin_health_list" model="ir.ui.view">
        <field name="name">product.template.margin.health.list</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list string="Margin Health" default_order="mh_margin_percent asc,name"
                  editable="bottom" create="false">
                <field name="name" readonly="1"/>
                <field name="list_price"/>
                <field name="standard_price"/>
                <field name="mh_margin_amount" readonly="1"
                       decoration-danger="mh_margin_amount &lt; 0"/>
                <field name="mh_margin_percent" readonly="1"
                       decoration-danger="mh_margin_status == 'below_cost'"
                       decoration-warning="mh_margin_status in ('zero_margin','thin')"/>
                <field name="mh_margin_status" readonly="1"
                       decoration-danger="mh_margin_status == 'below_cost'"
                       decoration-warning="mh_margin_status == 'zero_margin'"
                       decoration-muted="mh_margin_status in ('ok','no_cost','na')"/>
                <field name="mh_loss_leader" width="90"/>
                <field name="categ_id" optional="hide"/>
                <field name="mh_is_healthy" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_margin_health_search" model="ir.ui.view">
        <field name="name">product.template.margin.health.search</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <search string="Margin Health">
                <field name="name"/>
                <field name="categ_id"/>
                <filter name="losing" string="Losing Money"
                        domain="[('mh_margin_status','=','below_cost')]"
                        help="The list price is under the cost. Every sale loses money."/>
                <filter name="zero" string="No Margin"
                        domain="[('mh_margin_status','=','zero_margin')]"/>
                <filter name="thin" string="Thin Margin"
                        domain="[('mh_margin_status','=','thin')]"
                        help="Reported for visibility. Never counted as a fault."/>
                <separator/>
                <filter name="no_cost" string="No Cost Recorded"
                        domain="[('mh_margin_status','=','no_cost')]"
                        help="Margin cannot be judged until a cost exists."/>
                <filter name="loss_leader" string="Deliberate Loss Leaders"
                        domain="[('mh_loss_leader','=',True)]"/>
                <group>
                    <filter name="g_status" string="Margin Check"
                            context="{'group_by': 'mh_margin_status'}"/>
                    <filter name="g_categ" string="Product Category"
                            context="{'group_by': 'categ_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_margin_health" model="ir.actions.act_window">
        <field name="name">Product Margins</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_margin_health_list"/>
        <field name="search_view_id" ref="view_margin_health_search"/>
        <field name="context">{'search_default_losing': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing is being sold below cost.</p>
            <p>Just installed? Run <b>Margin Health &gt; Recheck Margins</b> once so
               existing products are measured.</p>
        </field>
    </record>

    <!-- ============ pricelist rules that can never apply ============ -->
    <record id="view_pricelist_health_list" model="ir.ui.view">
        <field name="name">product.pricelist.item.margin.health.list</field>
        <field name="model">product.pricelist.item</field>
        <field name="arch" type="xml">
            <list string="Pricelist Rules" default_order="pricelist_id,applied_on"
                  create="false">
                <field name="pricelist_id"/>
                <field name="name" string="Rule"/>
                <field name="applied_on"/>
                <field name="min_quantity"/>
                <field name="date_start" optional="show"/>
                <field name="date_end" optional="show"/>
                <field name="mh_rule_status"
                       decoration-danger="mh_rule_status == 'unreachable'"
                       decoration-warning="mh_rule_status == 'expired'"
                       decoration-muted="mh_rule_status in ('ok','future')"/>
                <field name="mh_shadowed_by" string="Beaten by"/>
            </list>
        </field>
    </record>

    <record id="view_pricelist_health_search" model="ir.ui.view">
        <field name="name">product.pricelist.item.margin.health.search</field>
        <field name="model">product.pricelist.item</field>
        <field name="arch" type="xml">
            <search string="Pricelist Rules">
                <field name="pricelist_id"/>
                <filter name="dead" string="Never Applies"
                        domain="[('mh_rule_status','=','unreachable')]"
                        help="Another rule always wins, so Odoo can never return this one."/>
                <filter name="expired" string="Expired"
                        domain="[('mh_rule_status','=','expired')]"/>
                <filter name="future" string="Not Started"
                        domain="[('mh_rule_status','=','future')]"/>
                <group>
                    <filter name="g_pl" string="Pricelist"
                            context="{'group_by': 'pricelist_id'}"/>
                    <filter name="g_st" string="Rule Check"
                            context="{'group_by': 'mh_rule_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pricelist_health" model="ir.actions.act_window">
        <field name="name">Pricelist Rules</field>
        <field name="res_model">product.pricelist.item</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_pricelist_health_list"/>
        <field name="search_view_id" ref="view_pricelist_health_search"/>
        <field name="context">{'search_default_dead': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every pricelist rule can be reached.</p>
            <p>Odoo returns the first rule that matches, so a rule sitting behind one
               that already covers the same ground never applies. Nothing here means
               nothing is dead.</p>
        </field>
    </record>

    <!-- ============ margin on the order itself ============ -->
    <record id="view_order_form_margin" model="ir.ui.view">
        <field name="name">sale.order.form.margin.health</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list//field[@name='price_subtotal']" position="after">
                <field name="mh_margin" optional="show" readonly="1"
                       decoration-danger="mh_below_floor"/>
                <field name="mh_margin_percent" optional="hide" readonly="1"
                       decoration-danger="mh_below_floor"/>
                <field name="mh_below_floor" column_invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="action_margin_rescan" model="ir.actions.server">
        <field name="name">Recheck Margins</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="state">code</field>
        <field name="code">action = model.action_margin_health_rescan()</field>
    </record>
    <record id="action_pricelist_rescan" model="ir.actions.server">
        <field name="name">Recheck Pricelist Rules</field>
        <field name="model_id" ref="product.model_product_pricelist_item"/>
        <field name="state">code</field>
        <field name="code">action = model.action_pricelist_rescan()</field>
    </record>

    <menuitem id="menu_margin_health_root" name="Margin Health"
              web_icon="miko_margin_health,static/description/icon.png" sequence="97"/>
    <menuitem id="menu_margin_products" name="Product Margins"
              parent="menu_margin_health_root" action="action_margin_health" sequence="10"/>
    <menuitem id="menu_margin_pricelists" name="Pricelist Rules"
              parent="menu_margin_health_root" action="action_pricelist_health" sequence="20"/>
    <menuitem id="menu_margin_rescan" name="Recheck Margins"
              parent="menu_margin_health_root" action="action_margin_rescan" sequence="30"/>
    <menuitem id="menu_pricelist_rescan" name="Recheck Pricelist Rules"
              parent="menu_margin_health_root" action="action_pricelist_rescan" sequence="40"/>
    <menuitem id="menu_margin_rules" name="Margin Rules"
              parent="menu_margin_health_root" action="action_margin_rules_current"
              sequence="90"/>

</odoo>
